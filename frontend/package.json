{
  "name": "vku-field-survey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:e2e": "node tests/offline.e2e.mjs",
    "format": "prettier --config .prettierrc.json --write src tests *.js *.json ../backend/src/**/*.java ../docs/*.md ../README.md"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/network": "^8.0.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-java": "^2.11.0",
    "vite": "8.3.3"
  }
}
